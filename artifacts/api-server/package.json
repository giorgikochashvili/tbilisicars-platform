    "test:integration:c2b3b1": "node --import tsx --test src/test/integration/regional-intake-c2b3b1.test.ts",
    "test:unit:c2b3b2":       "node --import tsx --test src/test/unit/regional-staff-email.test.ts src/test/unit/regional-staff-notifier.test.ts src/test/unit/regional-notification-reporter.test.ts",
    "verify:migration-0014": "tsx src/scripts/verify-migration-0014.ts",
    "test": "pnpm run test:unit"
